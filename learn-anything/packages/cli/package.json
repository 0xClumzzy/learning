{
  "name": "@0xclumzzy/peaches",
  "version": "2.0.0",
  "description": "Peaches \u2014 pick a topic, grow into it. AI-powered recursive learning with Socratic method, TDD practice, and spaced repetition",
  "keywords": [
    "peaches",
    "learning",
    "cli",
    "ai",
    "education",
    "socratic",
    "tdd",
    "spaced-repetition"
  ],
  "homepage": "https://github.com/0xClumzzy/peaches",
  "repository": {
    "type": "git",
    "url": "https://github.com/0xClumzzy/peaches"
  },
  "license": "MIT",
  "author": "0xClumzzy",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "peaches": "./bin/peaches.js"
  },
  "files": [
    "dist",
    "site-dist",
    "bin",
    "!dist/**/*.test.js",
    "!dist/**/__tests__",
    "!dist/**/*.map"
  ],
  "scripts": {
    "build": "node scripts/bundle-site.mjs && tsc",
    "dev": "tsc --watch",
    "dev:cli": "pnpm build && node bin/peaches.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "echo 'Lint from root'",
    "prepack": "npm run build"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@inquirer/prompts": "^7.8.0",
    "chalk": "^5.5.0",
    "commander": "^14.0.0",
    "fast-glob": "^3.3.3",
    "remark-parse": "^11.0.0",
    "unified": "^11.0.5",
    "yaml": "^2.8.2",
    "zod": "^4.0.17"
  }
}
